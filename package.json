{
  "name": "agent-kickoff",
  "version": "0.1.0",
  "description": "Scan a repo and give coding agents a knowledge base: a context skill, AGENTS.md, CLAUDE.md, subagents and Linear skills.",
  "type": "module",
  "bin": {
    "agent-kickoff": "dist/cli.js"
  },
  "files": ["dist", "templates"],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": ["claude", "claude-code", "agents", "AGENTS.md", "skills", "cli", "knowledge-base"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtrujilloaui/agent-kickoff.git"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/bun": "^1.4.2",
    "typescript": "^5"
  }
}
